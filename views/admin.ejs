<!DOCTYPE html>
<html>
<head>
    <title>Admin Panel - Premium Panel</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<div class="panel">

<h2>Admin Panel</h2>


<h3>Users</h3>

<table>

<tr>
<th>Username</th>
<th>Balance</th>
<th>Role</th>
</tr>


<% users.forEach(user=>{ %>

<tr>

<td>
<%= user.username %>
</td>

<td>
৳ <%= user.balance %>
</td>

<td>
<%= user.role %>
</td>

</tr>

<% }) %>


</table>



<h3>Submissions</h3>


<table>

<tr>
<th>Title</th>
<th>Status</th>
<th>Action</th>
</tr>


<% submissions.forEach(item=>{ %>

<tr>

<td>
<%= item.title %>
</td>


<td>
<%= item.status %>
</td>


<td>

<button onclick="updateSubmission('<%= item.id %>','approve')">
Approve
</button>


<button onclick="updateSubmission('<%= item.id %>','reject')">
Reject
</button>

</td>


</tr>

<% }) %>


</table>




<h3>Withdrawals</h3>


<table>

<tr>
<th>User</th>
<th>Amount</th>
<th>Status</th>
</tr>


<% withdrawals.forEach(item=>{ %>

<tr>

<td>
<%= item.userId %>
</td>


<td>
৳ <%= item.amount %>
</td>


<td>
<%= item.status %>
</td>


</tr>

<% }) %>


</table>


<a href="/dashboard">
Dashboard
</a>


</div>



<script>

async function updateSubmission(id,action){

    await fetch(
        `/admin/submission/${action}/${id}`,
        {
            method:"POST"
        }
    );

    location.reload();

}

</script>


</body>
</html>
