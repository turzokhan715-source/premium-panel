<!DOCTYPE html>
<html lang="bn">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wallet & Withdraw</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="card">
        <h2>Withdraw Funds</h2>
        <p class="subtitle">Request payout to your mobile wallet</p>

        <label>Payment Method</label>
        <select id="method">
            <option value="bkash">Bkash</option>
            <option value="nagad">Nagad</option>
            <option value="rocket">Rocket</option>
        </select>

        <label>Phone Number</label>
        <input type="text" id="phone" placeholder="017xxxxxxxx">

        <label>Amount (BDT)</label>
        <input type="number" id="amount" placeholder="0.00">

        <button class="btn" onclick="requestWithdraw()">Request Payout</button>
        <a href="/" class="switch-text">⬅ Back to Dashboard</a>
    </div>

    <script>
        function requestWithdraw() {
            const phone = document.getElementById('phone').value;
            const amount = document.getElementById('amount').value;
            if(!phone || !amount) return alert('Please fill in all details!');
            alert('Withdraw request submitted successfully!');
            window.location.href = '/';
        }
    </script>
</body>
</html>
